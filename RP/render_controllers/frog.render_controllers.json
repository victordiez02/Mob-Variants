// Copy of the vanilla controller.render.frog with the skin texture.
// v.mv_variant: 1-10 skin of the frog's own climate (temperate, cold, warm), 11-20 special skins.
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.frog": {
      "geometry": "Geometry.default",
      "part_visibility": [
        { "croaking_body": "!query.is_eating_mob" }
      ],
      "materials": [
        { "*": "Material.default" }
      ],
      "textures": ["array.mv_skins[v.mv_skin]"],
      "arrays": {
        "textures": {

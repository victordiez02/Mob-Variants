// Render controller sheep
// v.mv_variant: puede llevar cuernos (2) o no (1).
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.sheep": {
      "arrays": {
        "geometries": {
          "Array.geos": ["Geometry.mv_default", "Geometry.mv_sheared"]
        }
      },
      "geometry": "Array.geos[query.is_sheared]",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["Texture.mv_default"]
    },
    "controller.render.mv.sheep_horns": {
      "geometry": "!query.is_baby ? (v.mv_variant ? array.geosq[v.mv_variant - 1] : (variable.xvar < 30 ? Geometry.mv_horns : Geometry.mv_empty)) : Geometry.mv_empty",
      "materials": [
        { "*": "Material.mv_horns" }
      ],
      "textures": ["Texture.mv_horns"],
      "arrays": {
        "geometries": {
          "array.geosq": ["Geometry.mv_empty", "Geometry.mv_horns"]
        }
      }
    }
  }
}

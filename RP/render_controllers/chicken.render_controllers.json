// Copy of the vanilla controller.render.chicken.v3 with the skin texture.
// v.mv_variant: 1-4 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.chicken": {
      "geometry": "query.is_baby ? Geometry.baby : Array.geos[v.index]",
      "materials": [
        { "*": "v.is_cold ? Material.cold : Material.default" },
        { "leg*": "Material.legs" }
      ],
      "textures": ["array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "geometries": {
          "Array.geos": ["Geometry.default", "Geometry.warm", "Geometry.cold"]
        },
        "textures": {
          "array.mv_skins": ["Texture.mv_default", "Texture.mv_default2", "Texture.mv_default3", "Texture.mv_default4"]
        }
      }
    }
  }
}

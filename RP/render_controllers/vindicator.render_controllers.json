// Render controller vindicator
// v.mv_variant: skin del mob.
// v.mv_mark: si lleva armadura (1, 2, 3), armadura con bander (4) o no lleva armadura (0).
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.vindicator": {
      "geometry": "Geometry.mv_default",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["v.mv_variant ? array.xskins[v.mv_variant - 1] : array.xskins[variable.xvar]"],
      "arrays": {
        "textures": {
          "array.xskins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9",
            "Texture.mv_default10",
            "Texture.mv_default11",
            "Texture.mv_default12",
            "Texture.mv_default13",
            "Texture.mv_default14",
            "Texture.mv_default15",
            "Texture.mv_default16",
            "Texture.mv_default17",
            "Texture.mv_default18",
            "Texture.mv_default19",
            "Texture.mv_default20",
            "Texture.mv_default21",
            "Texture.mv_clown"
          ]
        }
      }
    },
    "controller.render.mv.vindicator_armor": {
      "geometry": "v.mv_variant ? array.xgeosq[v.mv_mark] : (variable.xvar < 40 ? array.xgeos[variable.xvar] : Geometry.mv_empty)",
      "materials": [
        { "*": "Material.mv_armor" }
      ],
      "textures": ["v.mv_variant ? array.xskinsq[v.mv_mark] : array.xskins[variable.xvar]"],
      "arrays": {
        "textures": {
          "array.xskins": ["Texture.mv_armor", "Texture.mv_armor2", "Texture.mv_armor3", "Texture.mv_armor4"],
          "array.xskinsq": [
            "Texture.mv_armor",
            "Texture.mv_armor",
            "Texture.mv_armor2",
            "Texture.mv_armor3",
            "Texture.mv_armor4"
          ]
        },
        "geometries": {
          "array.xgeos": ["Geometry.mv_armor", "Geometry.mv_armor", "Geometry.mv_armor", "Geometry.mv_armor2"],
          "array.xgeosq": [
            "Geometry.mv_empty",
            "Geometry.mv_armor",
            "Geometry.mv_armor",
            "Geometry.mv_armor",
            "Geometry.mv_armor2"
          ]
        }
      }
    }
  }
}

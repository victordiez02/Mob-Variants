
// One layer per profession (geometry.mv.villager_<profession>), chosen by profession_index (0 = none).
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.villager_v2_overlay": {
      "geometry": "array.geos[variable.profession_index]",
      "part_visibility": [
        { "*": "variable.profession_index != 0" }
      ],
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["array.xskins[variable.profession_index]"],
      "arrays": {
        "textures": {
          "array.xskins": [
            "Texture.mv_empty",
            "Texture.mv_farmer_overlay",
            "Texture.mv_fisherman_overlay",
            "Texture.mv_shepherd_overlay",
            "Texture.mv_fletcher_overlay",
            "Texture.mv_librarian_overlay",
            "Texture.mv_cartographer_overlay",
            "Texture.mv_cleric_overlay",
            "Texture.mv_armorer_overlay",
            "Texture.mv_weapon_smith_overlay",
            "Texture.mv_tool_smith_overlay",
            "Texture.mv_butcher_overlay",
            "Texture.mv_leatherworker_overlay",
            "Texture.mv_stonemason_overlay",
            "Texture.mv_nitwit_overlay"
          ]
        },
        "geometries": {
          "array.geos": [
            "Geometry.mv_farmer",
            "Geometry.mv_farmer",
            "Geometry.mv_fisherman",
            "Geometry.mv_shepherd",
            "Geometry.mv_fletcher",
            "Geometry.mv_librarian",
            "Geometry.mv_cartographer",
            "Geometry.mv_cleric",
            "Geometry.mv_armorer",
            "Geometry.mv_weapon_smith",
            "Geometry.mv_tool_smith",
            "Geometry.mv_butcher",
            "Geometry.mv_leatherworker",
            "Geometry.mv_stonemason",
            "Geometry.mv_nitwit"
          ]
        }
      }
    }
  }
}

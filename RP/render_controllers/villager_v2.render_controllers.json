{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.villager_v2_base": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.mv_base",
            "Texture.mv_base2",
            "Texture.mv_base3",
            "Texture.mv_base4",
            "Texture.mv_base5",
            "Texture.mv_base6"
          ]
        }
      },
      "geometry": "Geometry.mv_default",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["Array.skins[query.skin_id]"]
    },
    "controller.render.mv.villager_v2_masked": {
      "arrays": {
        "textures": {
          "Array.biomes": [
            "Texture.mv_plains",
            "Texture.mv_desert",
            "Texture.mv_jungle",
            "Texture.mv_savanna",
            "Texture.mv_snow",
            "Texture.mv_swamp",
            "Texture.mv_taiga"
          ],
          "Array.professions": [
            "Texture.mv_unskilled",
            "Texture.mv_farmer",
            "Texture.mv_fisherman",
            "Texture.mv_shepherd",
            "Texture.mv_fletcher",
            "Texture.mv_librarian",
            "Texture.mv_cartographer",
            "Texture.mv_cleric",
            "Texture.mv_armorer",
            "Texture.mv_weapon_smith",
            "Texture.mv_tool_smith",
            "Texture.mv_butcher",
            "Texture.mv_leatherworker",
            "Texture.mv_stonemason",
            "Texture.mv_nitwit"
          ]
        }
      },
      "geometry": "Geometry.mv_default",
      "materials": [
        {
          "*": "(query.is_baby || variable.profession_index == 0) ? Material.mv_default : Material.mv_masked"
        }
      ],
      "textures": ["Array.biomes[query.mark_variant]", "Array.professions[variable.profession_index]"]
    },
    "controller.render.mv.villager_v2_level": {
      "arrays": {
        "textures": {
          "Array.levels": [
            "Texture.mv_level_stone",
            "Texture.mv_level_iron",
            "Texture.mv_level_gold",
            "Texture.mv_level_emerald",
            "Texture.mv_level_diamond"
          ]
        }
      },
      "rebuild_animation_matrices": true,
      "geometry": "Geometry.mv_default",
      "part_visibility": [
        {
          "*": "!query.is_baby && variable.profession_index != 0 && variable.profession_index != 14"
        }
      ],
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["Array.levels[variable.level_index]"]
    }
  }
}

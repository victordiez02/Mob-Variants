// Copy of the vanilla controller.render.creeper with the skin texture.
// v.mv_variant: 1-18 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.creeper": {
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" }
      ],
      "textures": ["array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "textures": {
          "array.mv_skins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9",
            "Texture.mv_default10",
            "Texture.mv_default11",
            "Texture.mv_default12",
            "Texture.mv_default13",
            "Texture.mv_default14",
            "Texture.mv_default15",
            "Texture.mv_default16",
            "Texture.mv_default17",
            "Texture.mv_default18"
          ]
        }
      },
      "overlay_color": {
        "r": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 1.0",
        "g": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 1.0",
        "b": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 1.0",
        "a": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 0.5"
      }
    }
  }
}

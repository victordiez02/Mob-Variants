    },
    "controller.render.mv.evoker_hat": {
      "rebuild_animation_matrices": true,
      "geometry": "v.mv_variant ? array.geosq[v.mv_mark] : (variable.xvar < 30 ? array.geosd[variable.xvar] : Geometry.mv_hat)",
      "materials": [
        { "*": "Material.mv_glow" }
      ],
      "textures": [
        "v.mv_variant ? array.xskinsq[v.mv_mark] : (variable.xvar < 60 ? (variable.xvar < 30 ? array.dskins[variable.xvar] : array.xskins[variable.xvar]) : Texture.mv_no_hat)"
      ],
      "arrays": {
        "textures": {
          "array.xskins": ["Texture.mv_hat", "Texture.mv_hat2", "Texture.mv_hat3"],
          "array.dskins": [
            "Texture.mv_wizard",
            "Texture.mv_windcaller",
            "Texture.mv_enchanter",
            "Texture.mv_geomancer",
            "Texture.mv_chef"
          ],
          "array.xskinsq": [
            "Texture.mv_no_hat",
            "Texture.mv_hat",
            "Texture.mv_hat2",
            "Texture.mv_hat3",
            "Texture.mv_wizard",
            "Texture.mv_windcaller",

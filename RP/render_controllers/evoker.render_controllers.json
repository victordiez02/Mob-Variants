{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.evoker": {
      "geometry": "Geometry.mv_default",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["v.mv_variant ? array.xskins[v.mv_variant - 1] : array.xskins[variable.xvar]"],
      "arrays": {
        "textures": {
          "array.xskins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",

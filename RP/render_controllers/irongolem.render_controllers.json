{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.iron_golem": {
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "geometry": "Geometry.mv_default",
      "textures": ["v.mv_variant ? array.xskins[v.mv_variant - 1] : array.xskins[variable.xvar]"],
      "arrays": {
        "textures": {
          "array.xskins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9",
            "Texture.mv_default10",
            "Texture.mv_default11",
            "Texture.mv_default12",
            "Texture.mv_default13",
            "Texture.mv_default14",
            "Texture.mv_default15",
            "Texture.mv_item_sorter"
          ]
        }
      }
    },
    "controller.render.mv.irongolem_rose": {
      "rebuild_animation_matrices": true,
      "geometry": "v.mv_variant ? (v.mv_mark ? Geometry.mv_rose : Geometry.mv_empty) : (variable.xvar < 30 ? Geometry.mv_rose : Geometry.mv_empty)",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["Texture.mv_default2"]
    }
  }
}

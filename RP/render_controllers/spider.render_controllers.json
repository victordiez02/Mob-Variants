// Render controller spider
// v.mv_variant: skin del mob.
// v.mv_mark: si es araña gigante (1) o si no (0).
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.spider": {
      "geometry": "v.mv_variant ? array.geosq[v.mv_mark] : (variable.xvar < 85 ? Geometry.mv_default : Geometry.mv_giant_spider)",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["v.mv_variant ? array.xskins[v.mv_variant - 1] : array.xskins[variable.xvar]"],
      "arrays": {
        "textures": {
          "array.xskins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9",
            "Texture.mv_default10",
            "Texture.mv_default11",
            "Texture.mv_default12",
            "Texture.mv_default13",
            "Texture.mv_default14",
            "Texture.mv_default15",
            "Texture.mv_default16",
            "Texture.mv_default17",
            "Texture.mv_default18",
            "Texture.mv_default19",
            "Texture.mv_default20",
            "Texture.mv_default21",
            "Texture.mv_default22",
            "Texture.mv_default23",
            "Texture.mv_default24",
            "Texture.mv_default25",
            "Texture.mv_default26"
          ]
        },
        "geometries": {
          "array.geosq": ["Geometry.mv_default", "Geometry.mv_giant_spider"]
        }
      }
    }
  }
}

// Copy of the vanilla controller.render.spider with the skin texture.
// v.mv_variant: 1-25 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.spider": {
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Array.materials[query.is_invisible]" }
      ],
      "textures": ["array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "materials": {
          "Array.materials": ["Material.default", "Material.invisible"]
        },
        "textures": {
          "array.mv_skins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9",
            "Texture.mv_default10",
            "Texture.mv_default11",
            "Texture.mv_default12",
            "Texture.mv_default13",
            "Texture.mv_default14",
            "Texture.mv_default15",
            "Texture.mv_default16",
            "Texture.mv_default17",
            "Texture.mv_default18",
            "Texture.mv_default19",
            "Texture.mv_default20",
            "Texture.mv_default21",
            "Texture.mv_default22",
            "Texture.mv_default23",
            "Texture.mv_default24",
            "Texture.mv_default25"
          ]
        }
      }
    }
  }
}

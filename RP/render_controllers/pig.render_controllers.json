// Copy of the vanilla controller.render.pig.v4 with the skin texture.
// v.mv_variant: 1-5 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.pig": {
      "geometry": "Geometry.mv_legacy",
      "materials": [
        { "*": "Material.mv_legacy" }
      ],
      "textures": ["query.is_saddled ? array.mv_saddled[v.mv_variant - 1] : array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "textures": {
          "array.mv_skins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5"
          ],
          "array.mv_saddled": [
            "Texture.mv_saddled",
            "Texture.mv_saddled2",
            "Texture.mv_saddled3",
            "Texture.mv_saddled4",
            "Texture.mv_saddled5"
          ]
        }
      }
    }
  }
}

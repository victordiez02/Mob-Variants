// Copy of the vanilla controller.render.ghast with the skin texture.
// v.mv_variant: 1-13 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.ghast": {
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" }
      ],
      "textures": ["variable.ischarging ? array.mv_charging[v.mv_variant - 1] : array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "textures": {
          "array.mv_skins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9",
            "Texture.mv_default10",
            "Texture.mv_default11",
            "Texture.mv_default12",
            "Texture.mv_default13"
          ],
          "array.mv_charging": [
            "Texture.mv_charging",
            "Texture.mv_charging2",
            "Texture.mv_charging3",
            "Texture.mv_charging4",
            "Texture.mv_charging5",
            "Texture.mv_charging6",
            "Texture.mv_charging7",
            "Texture.mv_charging8",
            "Texture.mv_charging9",
            "Texture.mv_charging10",
            "Texture.mv_charging11",
            "Texture.mv_charging12",
            "Texture.mv_charging13"
          ]
        }
      }
    }
  }
}

// Copy of the vanilla controller.render.ender_dragon_default with the skin texture.
// v.mv_variant: 1-7 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.ender_dragon": {
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" }
      ],
      "textures": ["array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "textures": {
          "array.mv_skins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7"
          ]
        }
      }
    }
  }
}

// Render controller hoglin
// v.mv_variant: skin del mob.
// v.mv_mark: si tiene cabeza clavada (1, 2, 3) o si no (0).
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.hoglin": {
      "geometry": "Geometry.mv_default",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["v.mv_variant ? array.xskins[v.mv_variant - 1] : array.xskins[variable.xvar]"],
      "arrays": {
        "textures": {
          "array.xskins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9",
            "Texture.mv_default10",
            "Texture.mv_default11"
          ]
        }
      }
    },
    "controller.render.mv.hoglin_piglinhead": {
      "rebuild_animation_matrices": true,
      "geometry": "!query.is_baby ? (v.mv_variant ? array.geosq[v.mv_mark] : (variable.xvar < 10 ? Geometry.mv_piglinhead : (variable.xvar < 20 ? Geometry.mv_piglinhead2 : (variable.xvar < 30 ? Geometry.mv_wither_skull : Geometry.mv_empty))))",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["Texture.mv_piglinhead"],
      "arrays": {
        "geometries": {
          "array.geosq": [
            "Geometry.mv_empty",
            "Geometry.mv_piglinhead",
            "Geometry.mv_piglinhead2",
            "Geometry.mv_wither_skull"
          ]
        }
      }
    }
  }
}

            "Texture.mv_jungle",
            "Texture.mv_savanna",
            "Texture.mv_snow",
            "Texture.mv_swamp",
            "Texture.mv_taiga"
          ],
          "Array.professions": [
            "Texture.mv_farmer",
            "Texture.mv_fisherman",
            "Texture.mv_shepherd",
            "Texture.mv_fletcher",
            "Texture.mv_librarian",
            "Texture.mv_cartographer",
            "Texture.mv_cleric",
            "Texture.mv_armorer",
            "Texture.mv_weapon_smith",
            "Texture.mv_tool_smith",
            "Texture.mv_butcher",
            "Texture.mv_leatherworker",
            "Texture.mv_stonemason",
            "Texture.mv_nitwit"
          ]
        }
      },
      "geometry": "Geometry.mv_default",

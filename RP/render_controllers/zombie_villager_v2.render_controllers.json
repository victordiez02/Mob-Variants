// Copy of the vanilla controller.render.zombie_villager_v3_base with the skin texture.
// v.mv_variant: 1-9 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.zombie_villager_v2": {
      "geometry": "query.is_baby? Geometry.baby : Geometry.default",
      "materials": [
        { "*": "Material.default" }
      ],
      "textures": ["query.is_baby? Texture.baby_default : array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "textures": {
          "array.mv_skins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7",
            "Texture.mv_default8",
            "Texture.mv_default9"
          ]
        }
      }
    }
  }
}

{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.bee": {
      "arrays": {
        "textures": {
          "array.xskins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7"
          ],
          "array.askins": [
            "Texture.mv_angry",
            "Texture.mv_angry2",
            "Texture.mv_angry3",
            "Texture.mv_angry4",
            "Texture.mv_angry5",
            "Texture.mv_angry6",
            "Texture.mv_angry7"
          ]
        }
      },
      "geometry": "Geometry.mv_default",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": [
        "query.is_angry ? (v.mv_variant ? array.askins[v.mv_variant - 1] : array.askins[variable.xvar]) : (v.mv_variant ? array.xskins[v.mv_variant - 1] : array.xskins[variable.xvar])"
      ]
    },
    "controller.render.mv.bee_nectar": {
      "geometry": "Geometry.mv_nectar",
      "materials": [
        { "*": "Material.mv_default" }
      ],
      "textures": ["Texture.mv_nectar"]
    }
  }
}

// Copy of the vanilla controller.render.bee.v2 with the skin texture.
// v.mv_variant: 1-7 = array.mv_skins[v.mv_variant - 1]
{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mv.bee": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        { "*": "Material.default" }
      ],
      "textures": ["query.is_angry ? array.mv_angry[v.mv_variant - 1] : array.mv_skins[v.mv_variant - 1]"],
      "arrays": {
        "textures": {
          "array.mv_skins": [
            "Texture.mv_default",
            "Texture.mv_default2",
            "Texture.mv_default3",
            "Texture.mv_default4",
            "Texture.mv_default5",
            "Texture.mv_default6",
            "Texture.mv_default7"
          ],
          "array.mv_angry": [
            "Texture.mv_angry",
            "Texture.mv_angry2",
            "Texture.mv_angry3",
            "Texture.mv_angry4",
            "Texture.mv_angry5",
            "Texture.mv_angry6",
            "Texture.mv_angry7"
          ]
        }
      }
    }
  }
}

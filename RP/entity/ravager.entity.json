{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:ravager",
      "textures": {
        "default": "textures/entity/illager/ravager",
        "mv_default": "textures/entity/illager/ravager",
        "mv_default2": "textures/entity/illager/ravager2",
        "mv_default3": "textures/entity/illager/ravager3",
        "mv_default4": "textures/entity/illager/ravager4",
        "mv_default5": "textures/entity/illager/ravager5",
        "mv_default6": "textures/entity/illager/ravager6",
        "mv_default7": "textures/entity/illager/ravager7",
        "mv_default8": "textures/entity/illager/ravager8",
        "mv_default9": "textures/entity/illager/ravager9"
      },
      "materials": { "default": "ravager", "mv_default": "ravager" },
      "geometry": {
        "default": "geometry.ravager",
        "mv_default": "geometry.ravager"
      },
      "render_controllers": ["controller.render.mv.ravager"],
      "spawn_egg": { "texture": "spawn_egg_ravager" },
      "animations": {
        "walk": "animation.ravager.walk",
        "look_at_target": "animation.common.look_at_target",
        "idle_mouth": "animation.ravager.idle_mouth",
        "stunned": "animation.ravager.stunned",
        "roaring": "animation.ravager.roaring",
        "move": "controller.animation.ravager.move",
        "head": "controller.animation.ravager.head_movement",
        "biting": "animation.ravager.biting"
      },
      "scripts": {
        "pre_animation": [
          "variable.roar_length = 1.0;",
          "variable.bite_anim_duration = 0.75f;",
          "variable.bite_neck_length = 10;",
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : 0;"
        ],
        "animate": ["move", "head"],
        "initialize": ["v.xvar = Math.random(0,99);"]
      },
      "particle_effects": { "stun_particles": "minecraft:stunned_emitter" }
    }
  }
}

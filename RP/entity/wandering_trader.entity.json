{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:wandering_trader",
      "materials": { "mv_default": "wandering_trader" },
      "textures": {
        "mv_default": "textures/entity/wandering_trader",
        "mv_default2": "textures/entity/villager2/wandering_trader/wandering_trader2",
        "mv_default3": "textures/entity/villager2/wandering_trader/wandering_trader3",
        "mv_default4": "textures/entity/villager2/wandering_trader/wandering_trader4",
        "mv_default5": "textures/entity/villager2/wandering_trader/wandering_trader5",
        "mv_default6": "textures/entity/villager2/wandering_trader/wandering_trader6",
        "mv_default7": "textures/entity/villager2/wandering_trader/wandering_trader7",
        "mv_default8": "textures/entity/villager2/wandering_trader/wandering_trader8",
        "mv_default9": "textures/entity/villager2/wandering_trader/wandering_trader9",
        "mv_backpack": "textures/entity/skeleton/backpack"
      },
      "geometry": {
        "mv_default": "geometry.mv.villager_v2",
        "mv_backpack": "geometry.mv.wandering_trader_backpack"
      },
      "animations": {
        "walking": "animation.villager.walk",
        "blink": "animation.villager.eyelids",
        "death": "animation.villager.death",
        "panic": "animation.villager.panic",
        "idle": "animation.villager.idle",
        "general": "controller.animation.villager.general",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.villager.baby_transform",
        "get_in_bed": "animation.villager.get_in_bed"
      },
      "scripts": {
        "initialize": ["v.xvar = Math.random(0,99);"],
        "pre_animation": ["v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : 0;"],
        "scale": "0.9375",
        "animate": [
          { "baby_transform": "query.is_baby" },
          { "blink": "query.is_alive && !query.is_sleeping" },
          { "look_at_target": "query.is_alive && !query.is_sleeping" },
          { "death": "!query.is_alive" },
          "general"
        ]
      },
      "render_controllers": ["controller.render.mv.wandering_trader", "controller.render.mv.wandering_trader_backpack"],
      "spawn_egg": { "texture": "spawn_egg_wandering_trader" }
    }
  }
}

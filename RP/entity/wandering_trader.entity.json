// wandering_trader: vanilla client entity (wandering_trader.entity.json) + random skins (Mob Variants).
// v.mv_variant = mv:variant (BP) or a local roll (RP alone); 0 = vanilla. v.mv_active: draw the skins.
{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:wandering_trader",
      "materials": { "default": "wandering_trader" },
      "textures": {
        "default": "textures/entity/wandering_trader",
        "mv_default": "textures/entity/wandering_trader",
        "mv_default2": "textures/entity/villager2/wandering_trader/wandering_trader2",
        "mv_default3": "textures/entity/villager2/wandering_trader/wandering_trader3",
        "mv_default4": "textures/entity/villager2/wandering_trader/wandering_trader4",
        "mv_default5": "textures/entity/villager2/wandering_trader/wandering_trader5",
        "mv_default6": "textures/entity/villager2/wandering_trader/wandering_trader6",
        "mv_default7": "textures/entity/villager2/wandering_trader/wandering_trader7",
        "mv_default8": "textures/entity/villager2/wandering_trader/wandering_trader8",
        "mv_default9": "textures/entity/villager2/wandering_trader/wandering_trader9"
      },
      "geometry": { "default": "geometry.villager_v2" },
      "scripts": {
        "scale": "0.9375",
        "initialize": ["v.xvar = math.random_integer(1, 9);"],
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : v.xvar;",
          "v.mv_active = v.mv_variant > 0;"
        ],
        "animate": ["general_controller", "raise_arms_controller", "move_controller"]
      },
      "animations": {
        "general": "animation.villager.general",
        "look_at_target": "animation.common.look_at_target",
        "raise_arms": "animation.villager.raise_arms",
        "move": "animation.villager.move",
        "general_controller": "controller.animation.villager.general",
        "raise_arms_controller": "controller.animation.villager_v2.raise_arms",
        "move_controller": "controller.animation.villager.move"
      },
      "render_controllers": [
        { "controller.render.wandering_trader": "!v.mv_active" },
        { "controller.render.mv.wandering_trader": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_wandering_trader" }
    }
  }
}

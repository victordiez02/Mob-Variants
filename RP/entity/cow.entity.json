{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:cow",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "cow",
        "cold": "cow_cold",
        "mv_default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/cow/cow_v2",
        "warm": "textures/entity/cow/cow_warm",
        "cold": "textures/entity/cow/cow_cold",
        "baby_default": "textures/entity/cow/cow_temperate_baby",
        "baby_cold": "textures/entity/cow/cow_cold_baby",
        "baby_warm": "textures/entity/cow/cow_warm_baby",
        "mv_default": "textures/entity/cow/cow",
        "mv_default2": "textures/entity/cow/cow2",
        "mv_default3": "textures/entity/cow/cow3",
        "mv_default4": "textures/entity/cow/cow4",
        "mv_default5": "textures/entity/cow/cow5",
        "mv_default6": "textures/entity/cow/cow6",
        "mv_default7": "textures/entity/cow/cow7",
        "mv_default8": "textures/entity/cow/cow8",
        "mv_default9": "textures/entity/cow/cow9",
        "mv_default10": "textures/entity/cow/cow10"
      },
      "geometry": {
        "default": "geometry.cow.v2",
        "warm": "geometry.cow.warm",
        "cold": "geometry.cow.cold",
        "baby": "geometry.cow.baby",
        "mv_default": "geometry.mv.cow"
      },
      "animations": {
        "setup": "animation.cow.setup",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.cow.baby_transform",
        "vanilla_walk": "animation.quadruped.walk",
        "walk": "animation.cow.walk",
        "run": "animation.cow.run",
        "idle": "animation.cow.idle",
        "blink": "animation.cow.blink",
        "death": "animation.cow.death",
        "general": "controller.animation.cow.general",
        "eyelids": "controller.animation.cow.eyelids"
      },
      "scripts": {
        "initialize": ["v.xvar = Math.random(0,99);"],
        "pre_animation": [
          "t.variant = query.property('minecraft:climate_variant');",
          "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);",
          "v.is_cold = t.variant == 'cold';",
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : 0;",
          "v.mv_active = !q.is_baby && q.property('minecraft:climate_variant') == 'temperate';"
        ],
        "scale": "v.mv_active ? 1.0 : (query.is_baby ? 2.0 : 1.0)",
        "animate": [
          { "setup": "!v.mv_active" },
          {
            "vanilla_walk": "!v.mv_active && (query.modified_move_speed)"
          },
          {
            "look_at_target": "!v.mv_active || query.is_alive"
          },
          { "general": "v.mv_active" },
          { "eyelids": "v.mv_active" },
          { "death": "v.mv_active && (!query.is_alive)" },
          { "baby_transform": "v.mv_active && (query.is_baby)" }
        ]
      },
      "render_controllers": [
        { "controller.render.cow.v3": "!v.mv_active" },
        { "controller.render.mv.cow": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_cow" }
    }
  }
}

{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:blaze",
      "min_engine_version": "1.8.0",
      "materials": {
        "body": "blaze_body",
        "head": "blaze_head",
        "mv_body": "blaze_body",
        "mv_head": "blaze_head"
      },
      "textures": {
        "default": "textures/entity/blaze",
        "mv_default": "textures/entity/blaze",
        "mv_default2": "textures/entity/blaze/blaze2",
        "mv_default3": "textures/entity/blaze/blaze3",
        "mv_default4": "textures/entity/blaze/blaze4",
        "mv_default5": "textures/entity/blaze/blaze5",
        "mv_default6": "textures/entity/blaze/blaze6",
        "mv_default7": "textures/entity/blaze/blaze7",
        "mv_default8": "textures/entity/blaze/blaze8"
      },
      "geometry": {
        "default": "geometry.blaze",
        "mv_default": "geometry.blaze"
      },
      "animations": {
        "look_at_target": "animation.common.look_at_target",
        "move": "animation.blaze.move",
        "move_controller": "controller.animation.blaze.move",
        "flame": "controller.animation.blaze.flame"
      },
      "particle_effects": { "charged_flames": "minecraft:mobflame_emitter" },
      "render_controllers": ["controller.render.mv.blaze"],

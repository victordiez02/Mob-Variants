{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:fox",
      "materials": { "default": "fox", "mv_default": "fox" },
      "textures": {
        "red": "textures/entity/fox/fox",
        "arctic": "textures/entity/fox/arctic_fox",
        "baby_red": "textures/entity/fox/fox_baby",
        "baby_arctic": "textures/entity/fox/fox_snow_baby",
        "baby_sleep_red": "textures/entity/fox/fox_sleep_baby",
        "baby_sleep_arctic": "textures/entity/fox/fox_snow_sleep_baby",
        "mv_red": "textures/entity/fox/fox",
        "mv_perry": "textures/entity/fox/perry"
      },
      "geometry": {
        "default": "geometry.fox",
        "baby": "geometry.fox.baby",
        "mv_default": "geometry.mv.fox_bma",
        "mv_platypus": "geometry.mv.platypus",
        "mv_perry": "geometry.mv.platypus_perry"
      },
      "animations": {
        "walk": "animation.quadruped.walk",
        "look_at_target": "animation.common.look_at_target",
        "crouch": "animation.fox.crouch",
        "sleep": "animation.fox.sleep",
        "setup": "animation.fox.setup",
        "sit": "animation.fox.sit",
        "wiggle": "animation.fox.wiggle",
        "stuck": "animation.fox.stuck",
        "pounce": "animation.fox.pounce",
        "move": "controller.animation.fox.move",
        "baby_walk": "animation.fox.baby_walk",
        "baby_pounce": "animation.fox.baby_pounce",
        "baby_sit": "animation.fox.baby_sit",
        "baby_sleep": "animation.fox.baby_sleep",
        "baby_wiggle": "animation.fox.baby_wiggle",
        "blink": "animation.fox.blink",
        "idle": "animation.fox.idle",
        "general": "controller.animation.mv.fox.general",
        "mv_pounce": "animation.fox_bma.pounce",
        "mv_sleep": "animation.fox_bma.sleeping",
        "mv_walk": "animation.fox.walk",
        "mv_wiggle": "animation.fox_bma.wiggle"
      },
      "scripts": {
        "initialize": ["v.xvar = Math.random(0,99);"],
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : (v.xvar < 5 ? 2 : (v.xvar < 20 ? 1 : 0));",
          "v.mv_active = !q.is_baby && q.variant == 0;"
        ],
        "scale": "v.mv_active ? 1.0 : (query.is_baby ? 2.0 : 1.0)",
        "animate": [
          { "setup": "!v.mv_active" },
          { "move": "!v.mv_active" },
          { "blink": "v.mv_active && (!query.is_sleeping)" },
          { "look_at_target": "v.mv_active && (!query.is_sleeping)" },
          { "general": "v.mv_active" }
        ]
      },
      "render_controllers": [
        { "controller.render.fox.v2": "!v.mv_active" },
        { "controller.render.mv.fox": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_fox" }
    }
  }
}

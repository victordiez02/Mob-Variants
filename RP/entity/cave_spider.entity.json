{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:cave_spider",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "spider",
        "invisible": "spider_invisible",
        "mv_default": "enderman"
      },
      "textures": {
        "default": "textures/entity/spider/cave_spider",
        "mv_default": "textures/entity/spider/scorpion",
        "mv_default2": "textures/entity/spider/scorpion2",
        "mv_default3": "textures/entity/spider/scorpion3",
        "mv_default4": "textures/entity/spider/scorpion4",
        "mv_default5": "textures/entity/spider/scorpion5",
        "mv_default6": "textures/entity/spider/scorpion6",
        "mv_default7": "textures/entity/spider/scorpion7"
      },
      "geometry": {
        "default": "geometry.spider.v1.8",
        "mv_default": "geometry.spider.v1.8"
      },
      "scripts": {
        "scale": "0.7",
        "initialize": ["v.xvar = math.random(0,99);"],
        "pre_animation": ["v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : 0;"],
        "animate": ["move"]
      },
      "animations": {
        "default_leg_pose": "animation.spider.default_leg_pose",
        "look_at_target": "animation.spider.look_at_target",
        "walk": "animation.spider.walk",
        "move": "controller.animation.spider.move"
      },
      "render_controllers": ["controller.render.mv.cave_spider"],
      "spawn_egg": { "texture": "spawn_egg_cave_spider" }
    }

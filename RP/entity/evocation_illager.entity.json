// evocation_illager: vanilla client entity (evocation_illager.entity.json) + random skins (Mob Variants).
// v.mv_variant = mv:variant (BP) or a local roll (RP alone); 0 = vanilla. v.mv_active: draw the skins.
{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:evocation_illager",
      "min_engine_version": "1.8.0",
      "materials": { "default": "evoker" },
      "textures": {
        "default": "textures/entity/illager/evoker",
        "mv_default": "textures/entity/illager/evoker",
        "mv_default2": "textures/entity/illager/evoker2",
        "mv_default3": "textures/entity/illager/evoker3",
        "mv_default4": "textures/entity/illager/evoker4",
        "mv_default5": "textures/entity/illager/evoker5",
        "mv_default6": "textures/entity/illager/evoker6",
        "mv_default7": "textures/entity/illager/evoker7",
        "mv_default8": "textures/entity/illager/evoker8",
        "mv_default9": "textures/entity/illager/evoker9",
        "mv_default10": "textures/entity/illager/evoker10",
        "mv_default11": "textures/entity/illager/evoker11",
        "mv_default12": "textures/entity/illager/evoker12",
        "mv_default13": "textures/entity/illager/evoker13",
        "mv_default14": "textures/entity/illager/evoker14",
        "mv_default15": "textures/entity/illager/evoker15",
        "mv_default16": "textures/entity/illager/evoker16",
        "mv_default17": "textures/entity/illager/evoker17",
        "mv_default18": "textures/entity/illager/evoker18",
        "mv_default19": "textures/entity/illager/evoker19",
        "mv_default20": "textures/entity/illager/evoker20",
        "mv_default21": "textures/entity/illager/evoker21",
        "mv_default22": "textures/entity/illager/evoker22",
        "mv_default23": "textures/entity/illager/evoker23",
        "mv_default24": "textures/entity/illager/evoker24",
        "mv_default25": "textures/entity/illager/evoker25",
        "mv_default26": "textures/entity/illager/evoker26",
        "mv_default27": "textures/entity/illager/evoker27",
        "mv_default28": "textures/entity/illager/evoker29",
        "mv_default29": "textures/entity/illager/evoker30",
        "mv_default30": "textures/entity/illager/evoker31",
        "mv_default31": "textures/entity/illager/evoker32"
      },
      "geometry": { "default": "geometry.evoker.v1.8" },
      "scripts": {
        "scale": "0.9375",
        "animate": ["controller_general", "controller_move"],
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : v.xvar;",
          "v.mv_active = v.mv_variant > 0;",
          "variable.riding_y_offset_with_respect_to_player = 1.25;",
          "variable.riding_y_offset_on_vehicle_where_other_entites_can_stand = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat') ? -3.0 : 0.0;",
          "variable.riding_y_offset = variable.riding_y_offset_with_respect_to_player + variable.riding_y_offset_on_vehicle_where_other_entites_can_stand;"
        ],
        "initialize": ["v.xvar = math.random_integer(1, 31);"]
      },
      "animations": {
        "general": "animation.evoker.general",
        "casting": "animation.evoker.casting",
        "look_at_target": "animation.common.look_at_target",
        "move": "animation.evoker.move",
        "celebrating": "animation.humanoid.celebrating",
        "controller_general": "controller.animation.evoker.general",
        "controller_move": "controller.animation.villager.move",
        "riding.legs": "animation.humanoid.riding.legs",
        "controller_riding": "controller.animation.humanoid.riding_legs_only",
        "riding.body": "animation.humanoid.riding.body"
      },
      "particle_effects": { "spell": "minecraft:evoker_spell" },
      "render_controllers": [
        { "controller.render.evoker": "!v.mv_active" },
        { "controller.render.mv.evocation_illager": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_evoker" }
    }
  }
}

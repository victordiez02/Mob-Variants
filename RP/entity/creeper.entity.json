// creeper: vanilla client entity (creeper.entity.json) + random skins (Mob Variants).
// v.mv_variant = mv:variant (BP) or a local roll (RP alone); 0 = vanilla. v.mv_active: draw the skins.
{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:creeper",
      "min_engine_version": "1.8.0",
      "materials": { "default": "creeper", "charged": "charged_creeper" },
      "textures": {
        "default": "textures/entity/creeper/creeper",
        "charged": "textures/entity/creeper/creeper_armor",
        "mv_default": "textures/entity/creeper/creeper",
        "mv_default2": "textures/entity/creeper/creeper2",
        "mv_default3": "textures/entity/creeper/creeper3",
        "mv_default4": "textures/entity/creeper/creeper4",
        "mv_default5": "textures/entity/creeper/creeper5",
        "mv_default6": "textures/entity/creeper/creeper6",
        "mv_default7": "textures/entity/creeper/creeper7",
        "mv_default8": "textures/entity/creeper/creeper8",
        "mv_default9": "textures/entity/creeper/creeper9",
        "mv_default10": "textures/entity/creeper/creeper10",
        "mv_default11": "textures/entity/creeper/creeper11",
        "mv_default12": "textures/entity/creeper/creeper12",
        "mv_default13": "textures/entity/creeper/creeper13",
        "mv_default14": "textures/entity/creeper/creeper14",
        "mv_default15": "textures/entity/creeper/creeper15",
        "mv_default16": "textures/entity/creeper/creeper17",
        "mv_default17": "textures/entity/creeper/creeper18",
        "mv_default18": "textures/entity/creeper/creeper19"
      },
      "geometry": {
        "default": "geometry.creeper.v1.8",
        "charged": "geometry.creeper.charged.v1.8"
      },
      "spawn_egg": { "texture": "spawn_egg_creeper" },
      "scripts": {
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : v.xvar;",
          "v.mv_active = v.mv_variant > 0;",
          "variable.wobble = Math.sin(query.swell_amount * 5730) * query.swell_amount * 0.01 + 1.0;",
          "variable.swelling_scale1 = (Math.pow(Math.clamp(query.swell_amount, 0.0, 1.0), 4.0) * 0.4 + 1.0) * variable.wobble;",
          "variable.swelling_scale2 = (Math.pow(Math.clamp(query.swell_amount, 0.0, 1.0), 4.0) * 0.1 + 1.0) / variable.wobble;",
          "variable.leg_rot = Math.cos(query.modified_distance_moved * 38.17326) * 80.22 * query.modified_move_speed;",
          "variable.flash = Math.mod(Math.Round(query.swell_amount * 10.0), 2.0);"
        ],
        "animate": ["creeper_head_controller", "creeper_legs_controller", "creeper_swelling_controller"],
        "initialize": ["v.xvar = math.random_integer(1, 18);"]
      },
      "animations": {
        "creeper_head": "animation.common.look_at_target",
        "creeper_legs": "animation.creeper.legs",
        "creeper_swelling": "animation.creeper.swelling",
        "creeper_head_controller": "controller.animation.creeper.head",
        "creeper_legs_controller": "controller.animation.creeper.legs",
        "creeper_swelling_controller": "controller.animation.creeper.swelling"
      },
      "render_controllers": [
        { "controller.render.creeper": "!v.mv_active" },
        { "controller.render.mv.creeper": "v.mv_active" },
        { "controller.render.creeper_armor": "query.is_powered" }
      ]
    }
  }
}

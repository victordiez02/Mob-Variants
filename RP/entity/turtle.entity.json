{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:turtle",
      "materials": { "default": "turtle", "mv_default": "turtle" },
      "textures": {
        "default": "textures/entity/sea_turtle",
        "baby": "textures/entity/turtle/sea_turtle_baby",
        "mv_default": "textures/entity/sea_turtle",
        "mv_donatello": "textures/entity/sea_turtle/donatello",
        "mv_leonardo": "textures/entity/sea_turtle/leonardo",
        "mv_michelangelo": "textures/entity/sea_turtle/michelangelo",
        "mv_raphael": "textures/entity/sea_turtle/raphael",
        "mv_squirtle": "textures/entity/sea_turtle/squirtle"
      },
      "geometry": {
        "default": "geometry.turtle",
        "baby": "geometry.turtle.baby",
        "mv_default": "geometry.turtle"
      },
      "scripts": {
        "pre_animation": [
          "variable.timeMultiplier = query.has_rider ? 0.39972 : 1.0;",
          "variable.backLegMultiplier = query.has_rider ? 0.5 : 3.0;",
          "variable.frontLegMultiplier = query.has_rider ? 2.0 : 8.0;",
          "variable.legSpeedMultiplier = query.has_rider ? 2.0 : 5.0;",
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : 0;",
          "v.mv_active = !q.is_baby;"
        ],
        "scale": "query.is_baby ? (1 / 0.16) : 1.0",
        "initialize": ["v.xvar = Math.random(0,99);"],
        "animate": ["general_controller", "move_controller"]
      },
      "animations": {
        "general": "animation.turtle.general",
        "move": "animation.turtle.move",
        "ground_move": "animation.turtle.ground_move",
        "look_at_target": "animation.common.look_at_target",
        "move_baby": "animation.turtle.baby_move",
        "general_controller": "controller.animation.turtle.general",
        "move_controller": "controller.animation.turtle.move"
      },
      "render_controllers": [
        { "controller.render.turtle.v2": "!v.mv_active" },
        { "controller.render.mv.turtle": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_turtle" }
    }
  }
}

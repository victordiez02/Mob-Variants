// pig: vanilla client entity (pig.entity.json) + random skins (Mob Variants).
// v.mv_variant = mv:variant (BP) or a local roll (RP alone); 0 = vanilla. v.mv_active: draw the skins.
{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:pig",
      "min_engine_version": "1.8.0",
      "materials": { "default": "pig_v3", "mv_legacy": "pig" },
      "textures": {
        "default": "textures/entity/pig/pig_v3",
        "saddled": "textures/entity/pig/pig_saddle",
        "warm": "textures/entity/pig/pig_warm",
        "cold": "textures/entity/pig/pig_cold",
        "saddle": "textures/entity/saddle_v2",
        "baby_default": "textures/entity/pig/pig_temperate_baby",
        "baby_warm": "textures/entity/pig/pig_warm_baby",
        "baby_cold": "textures/entity/pig/pig_cold_baby",
        "mv_default": "textures/entity/pig/pig",
        "mv_default2": "textures/entity/pig/pig2",
        "mv_default3": "textures/entity/pig/pig3",
        "mv_default4": "textures/entity/pig/pig4",
        "mv_default5": "textures/entity/pig/pig5",
        "mv_saddled": "textures/entity/pig/pig_saddle",
        "mv_saddled2": "textures/entity/pig/pig_saddle2",
        "mv_saddled3": "textures/entity/pig/pig_saddle3",
        "mv_saddled4": "textures/entity/pig/pig_saddle4",
        "mv_saddled5": "textures/entity/pig/pig_saddle5"
      },
      "geometry": {
        "default": "geometry.pig.v3",
        "baby": "geometry.pig.baby",
        "mv_legacy": "geometry.pig"
      },
      "animations": {
        "setup": "animation.pig.setup",
        "walk": "animation.quadruped.walk",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.pig.baby_transform",
        "mv_setup_legacy": "animation.pig.setup.v1.0"
      },
      "scripts": {
        "animate": [
          { "setup": "!v.mv_active" },
          { "mv_setup_legacy": "v.mv_active" },
          { "walk": "query.modified_move_speed" },
          "look_at_target"
        ],
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : v.xvar;",
          "v.mv_active = v.mv_variant > 0 && (!q.is_baby && q.property('minecraft:climate_variant') == 'temperate');",
          "t.variant = query.property('minecraft:climate_variant');",
          "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);"
        ],
        "scale": "query.is_baby ? 2.0 : 1.0",
        "initialize": ["v.xvar = math.random_integer(1, 5);"]
      },
      "render_controllers": [
        { "controller.render.saddle": "!v.mv_active" },
        { "controller.render.pig.v4": "!v.mv_active" },
        { "controller.render.mv.pig": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_pig" }
    }
  }
}

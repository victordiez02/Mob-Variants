{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:pig",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "pig_v3",
        "mv_default": "entity_alphatest",
        "mv_glow": "enderman"
      },
      "textures": {
        "default": "textures/entity/pig/pig_v3",
        "saddled": "textures/entity/pig/pig_saddle",
        "warm": "textures/entity/pig/pig_warm",
        "cold": "textures/entity/pig/pig_cold",
        "saddle": "textures/entity/saddle_v2",
        "baby_default": "textures/entity/pig/pig_temperate_baby",
        "baby_warm": "textures/entity/pig/pig_warm_baby",
        "baby_cold": "textures/entity/pig/pig_cold_baby",
        "mv_default": "textures/entity/pig/pig",
        "mv_default2": "textures/entity/pig/pig2",
        "mv_default3": "textures/entity/pig/pig3",
        "mv_default4": "textures/entity/pig/pig4",
        "mv_default5": "textures/entity/pig/pig5",
        "mv_saddled": "textures/entity/pig/pig_saddle",
        "mv_saddled2": "textures/entity/pig/pig_saddle2",
        "mv_saddled3": "textures/entity/pig/pig_saddle3",
        "mv_saddled4": "textures/entity/pig/pig_saddle4",
        "mv_saddled5": "textures/entity/pig/pig_saddle5",
        "mv_capibara": "textures/entity/pig/capibara",
        "mv_capibara_saddle": "textures/entity/pig/capibara_saddle",
        "mv_snail": "textures/entity/pig/snail",
        "mv_snail_saddle": "textures/entity/pig/snail_saddle",
        "mv_gold": "textures/entity/pig/pig_gold",
        "mv_gold_saddle": "textures/entity/pig/pig_gold_saddle",
        "mv_chest": "textures/entity/pig/pig_chest",
        "mv_flower": "textures/entity/iron_golem/iron_golem2"
      },
      "geometry": {
        "default": "geometry.pig.v3",
        "baby": "geometry.pig.baby",
        "mv_default": "geometry.mv.pig",
        "mv_capibara": "geometry.mv.capibara",
        "mv_snail": "geometry.mv.snail",
        "mv_chest": "geometry.mv.pig_chest",
        "mv_flower": "geometry.mv.pig_flower",
        "mv_empty": "geometry.mv.zombie_empty"
      },
      "animations": {
        "setup": "animation.pig.setup",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.pig.baby_transform",
        "vanilla_walk": "animation.quadruped.walk",
        "walk": "animation.pig.walk",
        "idle": "animation.pig.idle",
        "blink": "animation.pig.blink",
        "death": "animation.pig.death",
        "general": "controller.animation.pig.general"
      },
      "scripts": {
        "initialize": ["v.xvar = Math.random(0,99);"],
        "pre_animation": [
          "t.variant = query.property('minecraft:climate_variant');",
          "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);",
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : 0;",
          "v.mv_mark = q.has_property('mv:mark_variant') ? q.property('mv:mark_variant') : 0;",
          "v.mv_active = !q.is_baby && q.property('minecraft:climate_variant') == 'temperate';"
        ],
        "scale": "v.mv_active ? 1.0 : (query.is_baby ? 2.0 : 1.0)",
        "animate": [
          { "setup": "!v.mv_active" },
          {
            "vanilla_walk": "!v.mv_active && (query.modified_move_speed)"
          },
          {
            "look_at_target": "!v.mv_active || query.is_alive"
          },
          { "general": "v.mv_active" },
          { "blink": "v.mv_active" },
          { "baby_transform": "v.mv_active && (query.is_baby)" }
        ]
      },
      "render_controllers": [
        { "controller.render.saddle": "!v.mv_active" },
        { "controller.render.pig.v4": "!v.mv_active" },
        { "controller.render.mv.pig": "v.mv_active" },
        { "controller.render.mv.pig_chest": "v.mv_active" },
        { "controller.render.mv.pig_flower": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_pig" }
    }
  }
}

        "mv_default9": "textures/entity/spider/spider9",
        "mv_default10": "textures/entity/spider/spider10",
        "mv_default11": "textures/entity/spider/spider11",
        "mv_default12": "textures/entity/spider/spider12",
        "mv_default13": "textures/entity/spider/spider13",
        "mv_default14": "textures/entity/spider/spider14",
        "mv_default15": "textures/entity/spider/spider15",
        "mv_default16": "textures/entity/spider/spider16",
        "mv_default17": "textures/entity/spider/spider17",
        "mv_default18": "textures/entity/spider/spider18",

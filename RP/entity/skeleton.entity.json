// skeleton: vanilla client entity (skeleton.entity.json) + random skins (Mob Variants).
// v.mv_variant = mv:variant (BP) or a local roll (RP alone); 0 = vanilla. v.mv_active: draw the skins.
{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:skeleton",
      "min_engine_version": "1.8.0",
      "materials": { "default": "skeleton" },
      "textures": {
        "default": "textures/entity/skeleton/skeleton",
        "mv_default": "textures/entity/skeleton/skeleton",
        "mv_default2": "textures/entity/skeleton/skeleton2",
        "mv_default3": "textures/entity/skeleton/skeleton3",
        "mv_default4": "textures/entity/skeleton/skeleton4",
        "mv_default5": "textures/entity/skeleton/skeleton5",
        "mv_default6": "textures/entity/skeleton/skeleton6",
        "mv_default7": "textures/entity/skeleton/skeleton7",
        "mv_default8": "textures/entity/skeleton/skeleton8",
        "mv_default9": "textures/entity/skeleton/skeleton9",
        "mv_default10": "textures/entity/skeleton/skeleton10",
        "mv_default11": "textures/entity/skeleton/skeleton11",
        "mv_default12": "textures/entity/skeleton/skeleton12",
        "mv_default13": "textures/entity/skeleton/skeleton13",
        "mv_default14": "textures/entity/skeleton/skeleton14",
        "mv_default15": "textures/entity/skeleton/skeleton15"
      },
      "geometry": { "default": "geometry.skeleton.v1.8" },
      "spawn_egg": { "texture": "spawn_egg_skeleton" },
      "scripts": {
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : v.xvar;",
          "v.mv_active = v.mv_variant > 0;",
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.riding_y_offset_with_respect_to_player = 0.5;",
          "variable.riding_y_offset_on_vehicle_where_other_entites_can_stand = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat') ? -3.0 : 0.0;",
          "variable.riding_y_offset = variable.riding_y_offset_with_respect_to_player + variable.riding_y_offset_on_vehicle_where_other_entites_can_stand;"
        ],
        "initialize": ["v.xvar = math.random_integer(1, 15);"],
        "animate": [
          "look_at_target",
          "move_controller",
          "riding",
          "holding_controller",
          "brandish_spear_controller",
          "charging_controller",
          "attack",
          "sneaking_controller",
          "bob_controller",
          "damage_nearby_mobs_controller",
          "bow_and_arrow_controller",
          "swimming_controller",
          "use_item_progress_controller",
          "skeleton_attack_controller"
        ]
      },
      "animations": {
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "move": "animation.humanoid.move",
        "riding.arms": "animation.humanoid.riding.arms",
        "riding.legs": "animation.humanoid.riding.legs",
        "holding": "animation.humanoid.holding",
        "brandish_spear": "animation.humanoid.brandish_spear",
        "charging": "animation.humanoid.charging",
        "attack.rotations": "animation.humanoid.attack.rotations",
        "sneaking": "animation.humanoid.sneaking",
        "bob": "animation.humanoid.bob",
        "damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
        "bow_and_arrow": "animation.humanoid.bow_and_arrow",
        "swimming": "animation.zombie.swimming",
        "use_item_progress": "animation.humanoid.use_item_progress",
        "skeleton_attack": "animation.skeleton.attack",
        "riding.body": "animation.humanoid.riding.body",
        "look_at_target": "controller.animation.humanoid.look_at_target",
        "move_controller": "controller.animation.humanoid.move",
        "riding": "controller.animation.humanoid.riding",
        "holding_controller": "controller.animation.humanoid.holding",
        "brandish_spear_controller": "controller.animation.humanoid.brandish_spear",
        "charging_controller": "controller.animation.humanoid.charging",
        "attack": "controller.animation.humanoid.attack",
        "sneaking_controller": "controller.animation.humanoid.sneaking",
        "bob_controller": "controller.animation.humanoid.bob",
        "damage_nearby_mobs_controller": "controller.animation.humanoid.damage_nearby_mobs",
        "bow_and_arrow_controller": "controller.animation.humanoid.bow_and_arrow",
        "swimming_controller": "controller.animation.zombie.swimming",
        "use_item_progress_controller": "controller.animation.humanoid.use_item_progress",
        "skeleton_attack_controller": "controller.animation.skeleton.attack"
      },
      "render_controllers": [
        { "controller.render.skeleton": "!v.mv_active" },
        { "controller.render.mv.skeleton": "v.mv_active" }
      ],
      "enable_attachables": true
    }
  }
}

{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:mooshroom",
      "min_engine_version": "1.8.0",
      "materials": { "default": "mooshroom", "mv_default": "entity_alphatest" },
      "textures": {
        "default": "textures/entity/cow/mooshroom_v2",
        "brown": "textures/entity/cow/brown_mooshroom_v2",
        "baby_default": "textures/entity/cow/mooshroom_red_baby",
        "baby_brown": "textures/entity/cow/mooshroom_brown_baby",
        "mv_default": "textures/entity/cow/mooshroom",
        "mv_brown": "textures/entity/cow/brown_mooshroom"
      },
      "geometry": {
        "default": "geometry.mooshroom.v2",
        "baby": "geometry.cow.baby",
        "mv_default": "geometry.mv.cow"
      },
      "animations": {
        "setup": "controller.animation.mooshroom.setup",
        "walk": "animation.quadruped.walk",
        "look_at_target": "animation.common.look_at_target",
        "move": "controller.animation.mooshroom.move",
        "vanilla_baby_transform": "animation.mooshroom.baby_transform",
        "blink": "animation.cow.blink",
        "death": "animation.cow.death",
        "baby_transform": "animation.cow.baby_transform",
        "general": "controller.animation.mv.cow.general",
        "eyelids": "controller.animation.cow.eyelids",
        "mv_walk": "animation.cow.walk"
      },
      "scripts": {
        "pre_animation": ["v.mv_active = !q.is_baby;"],
        "scale": "v.mv_active ? 1.0 : (query.is_baby ? 2.0 : 1.0)",
        "animate": [
          { "setup": "!v.mv_active" },
          { "move": "!v.mv_active" },
          { "look_at_target": "v.mv_active" },
          { "general": "v.mv_active" },
          { "eyelids": "v.mv_active" },
          { "death": "v.mv_active && (query.health == 0)" },
          { "baby_transform": "v.mv_active && (query.is_baby)" }
        ]
      },
      "render_controllers": [
        { "controller.render.mooshroom.v2": "!v.mv_active" },
        { "controller.render.mv.mooshroom": "v.mv_active" }
      ],
      "spawn_egg": { "texture": "spawn_egg_mooshroom" }
    }
  }
}

// iron_golem: vanilla client entity (iron_golem.entity.json) + random skins (Mob Variants).
// v.mv_variant = mv:variant (BP) or a local roll (RP alone); 0 = vanilla. v.mv_active: draw the skins.
{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:iron_golem",
      "materials": { "default": "iron_golem" },
      "textures": {
        "default": "textures/entity/iron_golem",
        "cracked_high": "textures/entity/iron_golem/cracked_high",
        "cracked_med": "textures/entity/iron_golem/cracked_medium",
        "cracked_low": "textures/entity/iron_golem/cracked_low",
        "cracked_none": "textures/entity/iron_golem/cracked_none",
        "mv_default": "textures/entity/iron_golem/iron_golem",
        "mv_default2": "textures/entity/iron_golem/iron_golem2",
        "mv_default3": "textures/entity/iron_golem/iron_golem3",
        "mv_default4": "textures/entity/iron_golem/iron_golem4",
        "mv_default5": "textures/entity/iron_golem/iron_golem5",
        "mv_default6": "textures/entity/iron_golem/iron_golem6",
        "mv_default7": "textures/entity/iron_golem/iron_golem7",
        "mv_default8": "textures/entity/iron_golem/iron_golem8",
        "mv_default9": "textures/entity/iron_golem/iron_golem9",
        "mv_default10": "textures/entity/iron_golem/iron_golem10",
        "mv_default11": "textures/entity/iron_golem/iron_golem11",
        "mv_default12": "textures/entity/iron_golem/iron_golem12",
        "mv_default13": "textures/entity/iron_golem/iron_golem13",
        "mv_default14": "textures/entity/iron_golem/iron_golem14",
        "mv_default15": "textures/entity/iron_golem/iron_golem15"
      },
      "geometry": { "default": "geometry.irongolem" },
      "animations": {
        "walk": "animation.iron_golem.walk",
        "move": "animation.iron_golem.move",
        "attack": "animation.iron_golem.attack",
        "flower": "animation.iron_golem.flower",
        "look_at_target": "animation.common.look_at_target",
        "walk_to_target": "animation.iron_golem.walk_to_target",
        "move_to_target": "animation.iron_golem.move_to_target",
        "move_controller": "controller.animation.iron_golem.move",
        "arm_controller": "controller.animation.iron_golem.arm_movement"
      },
      "render_controllers": ["controller.render.mv.iron_golem", "controller.render.iron_golem_cracks"],
      "scripts": {
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : v.xvar;",
          "v.mv_active = v.mv_variant > 0;",
          "variable.modified_tcos0 = Math.clamp(((Math.cos(query.modified_distance_moved * 13.5) * Math.min(query.modified_move_speed, 0.6) / variable.gliding_speed_value) * 25.0), -12.5, 12.5);"
        ],
        "animate": ["look_at_target", "move_controller", "arm_controller"],
        "initialize": ["v.xvar = math.random_integer(1, 15);"]
      },
      "spawn_egg": { "texture": "spawn_egg_iron_golem" }
    }
  }
}

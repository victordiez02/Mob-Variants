{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:hoglin",
      "materials": { "default": "hoglin", "mv_default": "hoglin" },
      "textures": {
        "default": "textures/entity/hoglin/hoglin",
        "baby": "textures/entity/hoglin/hoglin_baby",
        "mv_default": "textures/entity/hoglin/hoglin",
        "mv_default2": "textures/entity/hoglin/hoglin2",
        "mv_default3": "textures/entity/hoglin/hoglin3",
        "mv_default4": "textures/entity/hoglin/hoglin4",
        "mv_default5": "textures/entity/hoglin/hoglin5",
        "mv_default6": "textures/entity/hoglin/hoglin6",
        "mv_default7": "textures/entity/hoglin/hoglin7",
        "mv_default8": "textures/entity/hoglin/hoglin8",
        "mv_default9": "textures/entity/hoglin/hoglin9",
        "mv_default10": "textures/entity/hoglin/hoglin10",
        "mv_default11": "textures/entity/hoglin/hoglin11",
        "mv_piglinhead": "textures/entity/skeleton/piglin_heads"
      },
      "geometry": {
        "default": "geometry.hoglin",
        "baby": "geometry.hoglin.baby",
        "mv_default": "geometry.hoglin",
        "mv_empty": "geometry.mv.zombie_empty",
        "mv_piglinhead": "geometry.mv.hoglin_piglinhead",
        "mv_piglinhead2": "geometry.mv.hoglin_piglinhead2",
        "mv_wither_skull": "geometry.mv.hoglin_wither_skull"
      },
      "spawn_egg": { "texture": "spawn_egg_hoglin" },
      "animations": {
        "walk": "animation.hoglin.walk",
        "look_at_target": "animation.hoglin.look_at_target",
        "attack": "animation.hoglin.attack",
        "hoglin_baby_scaling": "animation.hoglin.baby_scaling",
        "look_at_target_controller": "controller.animation.hoglin.look_at_target",
        "walk_controller": "controller.animation.hoglin.walk",
        "attack_controller": "controller.animation.hoglin.attack"
      },
      "render_controllers": [
        { "controller.render.hoglin.v2": "!v.mv_active" },
        { "controller.render.mv.hoglin": "v.mv_active" },
        { "controller.render.mv.hoglin_piglinhead": "v.mv_active" }
      ],
      "scripts": {
        "pre_animation": [
          "v.mv_variant = q.has_property('mv:variant') ? q.property('mv:variant') : 0;",
          "v.mv_mark = q.has_property('mv:mark_variant') ? q.property('mv:mark_variant') : 0;",
          "v.mv_active = !q.is_baby;",
          "variable.tcos_right_side = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.tcos_left_side = -variable.tcos_right_side;",
          "variable.attack_head_rot =  Math.sin(variable.attack_time * 180.0) * -37.3;"
        ],
        "scale": "query.is_baby ? 2.0 : 1.0",
        "animate": ["look_at_target_controller", "walk_controller", "attack_controller"],
        "initialize": ["v.xvar = Math.random(0,99);"]
      }
    }
  }
}
